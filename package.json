{
  "name": "reviewflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered reputation management platform for agencies and local businesses.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:unused": "knip",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "eslint": "^9",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "rimraf": "^6.0.1",
    "syncpack": "^15.3.2",
    "turbo": "^2.3.0",
    "typescript": "^5",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.10"
  }
}
