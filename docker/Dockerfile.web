# syntax=docker/dockerfile:1

# Builds a production image for apps/web (@reviewflow/web) from the pnpm/
# Turborepo monorepo root. Build from the repo root:
#   docker build -f docker/Dockerfile.web -t reviewflow-web .

FROM node:25-alpine AS base
RUN corepack enable
RUN apk add --no-cache libc6-compat

# ---------------------------------------------------------------------------
# 1. Prune the monorepo down to only what @reviewflow/web needs to build/run
# ---------------------------------------------------------------------------
FROM base AS pruner
WORKDIR /app
COPY . .
RUN npx turbo prune @reviewflow/web --docker
# No .git directory exists in this build context, and husky itself is a
# devDependency the --prod install stage below never installs — strip the
# root `prepare` script so neither install stage tries to run it.
RUN npm pkg delete scripts.prepare --prefix out/json

# ---------------------------------------------------------------------------
# 2. Install all dependencies (incl. dev) and build
# ---------------------------------------------------------------------------
FROM base AS builder
WORKDIR /app
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
# `turbo prune` only tracks package.json-declared dependencies — root config
# files referenced solely by relative path (tsconfig.json's `extends`,
# eslint's flat-config upward resolution) aren't in its output and must be
# copied explicitly from the unpruned checkout.
COPY --from=pruner /app/tsconfig.base.json ./tsconfig.base.json
COPY --from=pruner /app/eslint.config.mjs ./eslint.config.mjs
RUN pnpm turbo run build --filter=@reviewflow/web

# ---------------------------------------------------------------------------
# 3. A second, production-only install — keeps devDependencies (drizzle-kit,
#    typescript, eslint, …) out of the runtime image's node_modules.
# ---------------------------------------------------------------------------
FROM base AS prod-deps
WORKDIR /app
COPY --from=pruner /app/out/json/ .
RUN pnpm install --prod --frozen-lockfile

# ---------------------------------------------------------------------------
# 4. Runtime image
# ---------------------------------------------------------------------------
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

# Production node_modules (root + per-workspace) — pnpm's symlinked layout
# needs the workspace packages' real source alongside it, copied next.
COPY --from=prod-deps --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=prod-deps --chown=nextjs:nodejs /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=pruner --chown=nextjs:nodejs /app/out/full/packages ./packages

# Build output only — not the full builder stage, so build-time devDependencies never reach this image.
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next ./apps/web/.next
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/package.json ./apps/web/package.json
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/next.config.mjs ./apps/web/next.config.mjs

USER nextjs
WORKDIR /app/apps/web
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:3000/api/live || exit 1

# Invokes next's entry script directly via `node`, rather than `pnpm exec`/
# `pnpm start` or the node_modules/.bin/next symlink — pnpm's project
# detection expects pnpm-workspace.yaml, which this runtime layer
# deliberately doesn't have, and this sidesteps any doubt about the .bin
# symlink's executable bit surviving the multi-stage COPYs above.
CMD ["node", "node_modules/next/dist/bin/next", "start"]
