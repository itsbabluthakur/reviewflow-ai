{
  "name": "reviewflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered reputation management platform for agencies and local businesses.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:unused": "knip",
    "db:generate": "pnpm --filter @reviewflow/database run db:generate",
    "db:migrate": "pnpm --filter @reviewflow/database run db:migrate",
    "db:seed": "pnpm --filter @reviewflow/database run db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.0.1",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.7",
    "typescript": "^7",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
