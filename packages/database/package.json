{
  "name": "@reviewflow/database",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle ORM schema, client, migrations, and repository infrastructure for ReviewFlow AI.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "test": "vitest run",
    "clean": "rimraf .turbo dist node_modules"
  },
  "devDependencies": {
    "@types/node": "^20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@reviewflow/config": "workspace:*",
    "@reviewflow/errors": "workspace:*",
    "@reviewflow/logger": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  }
}
