{
  "name": "@reviewflow/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent authentication/session layer bridging Supabase Auth identities to ReviewFlow AI's application user model.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./middleware": "./src/middleware.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf .turbo dist node_modules"
  },
  "dependencies": {
    "@reviewflow/database": "workspace:*",
    "@reviewflow/errors": "workspace:*",
    "@reviewflow/logger": "workspace:*",
    "@reviewflow/supabase": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10",
    "postgres": "^3.4.9",
    "typescript": "^7",
    "vitest": "^4.1.10"
  }
}
