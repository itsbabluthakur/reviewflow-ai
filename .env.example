# =============================================================================
# ReviewFlow AI — Environment Variables
# =============================================================================
#
# Copy this file to `.env.local` and fill in real values:
#
#   cp .env.example .env.local
#
# Never commit `.env.local` or any file containing real secrets.
# See SECURITY.md section 7 (Secrets Management) for handling rules.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Human-readable environment name. One of: development | staging | production
NODE_ENV=development

# Publicly reachable base URL of the app, no trailing slash.
# Used for building absolute links (emails, OAuth callbacks, webhooks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign/encrypt server-side session cookies. Generate with:
#   openssl rand -base64 32
APP_SECRET=


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# https://supabase.com/dashboard/project/_/settings/api

# Project API URL.
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key — safe to expose to the browser, relies on RLS for safety.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — full database access, bypasses RLS.
# Server-side only. NEVER expose to the client. See SECURITY.md section 6.
SUPABASE_SERVICE_ROLE_KEY=

# Local CLI project ref, used by `supabase` CLI commands (supabase/README.md).
SUPABASE_PROJECT_REF=


# -----------------------------------------------------------------------------
# Database (direct Postgres connection, used by Drizzle ORM / migrations)
# -----------------------------------------------------------------------------

# Full Postgres connection string, e.g.
# postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_URL=

# Optional separate URL for connection pooling (e.g. Supabase pgBouncer / Supavisor)
# in transaction mode, used by serverless/edge runtimes.
DATABASE_POOL_URL=


# -----------------------------------------------------------------------------
# Google OAuth (login + Google Business Profile integration)
# -----------------------------------------------------------------------------
# https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match the redirect URI configured in the Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback


# -----------------------------------------------------------------------------
# OpenAI (AI reply drafts, sentiment analysis, summaries)
# -----------------------------------------------------------------------------
# https://platform.openai.com/api-keys

OPENAI_API_KEY=

# Optional: override default model per environment.
OPENAI_MODEL=gpt-4.1-mini


# -----------------------------------------------------------------------------
# Stripe (subscription billing)
# -----------------------------------------------------------------------------
# https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signing secret for verifying incoming Stripe webhook events.
STRIPE_WEBHOOK_SECRET=

# Price IDs for each subscription plan (see PRD.md section 10, Pricing).
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_AGENCY=


# -----------------------------------------------------------------------------
# Resend (transactional + campaign email delivery)
# -----------------------------------------------------------------------------
# https://resend.com/api-keys

RESEND_API_KEY=

# Verified sending address/domain.
RESEND_FROM_EMAIL=notifications@reviewflow.ai


# -----------------------------------------------------------------------------
# Twilio (SMS + WhatsApp review requests)
# -----------------------------------------------------------------------------
# https://console.twilio.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio phone number used to send SMS, in E.164 format.
TWILIO_SMS_FROM_NUMBER=

# WhatsApp Cloud API (via Twilio or Meta directly — pick one integration path).
TWILIO_WHATSAPP_FROM_NUMBER=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=


# -----------------------------------------------------------------------------
# Sentry (error tracking)
# -----------------------------------------------------------------------------
# https://sentry.io

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


# -----------------------------------------------------------------------------
# Analytics (PostHog)
# -----------------------------------------------------------------------------
# https://posthog.com

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# -----------------------------------------------------------------------------
# Future integrations
# -----------------------------------------------------------------------------
# Reserved keys for roadmap items (see ROADMAP.md). Uncomment and populate
# when the corresponding feature is implemented — do not add speculative
# values before they're needed.

# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# NFC_PROVIDER_API_KEY=
# PUBLIC_API_JWT_SIGNING_SECRET=
